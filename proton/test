# the deadline and the timeout of a command, in this process
slow = start(world(), delay=1.5)
base = "http://127.0.0.1:%d" % slow.port
saved = P.TIMEOUT, P.BUDGET
try:
    P.TIMEOUT = 0.4
    bridge = P.Bridge(base, CREDENTIAL)
    try:
        P.call_search({"q": "from:alice"}, lambda: bridge)
        ok("a search Bridge does not answer in time is refused", False)
    except P.Refusal as e:
        ok("a search Bridge does not answer in time is refused, saying so", "did not answer the search in time" in str(e), e)
    P.TIMEOUT = saved[0]
    P.BUDGET = -1
    try:
        P.call_search({}, lambda: P.Bridge(base, CREDENTIAL))
        ok("a call over its deadline is refused", False)
    except P.Refusal as e:
        ok("a call over its deadline is refused, saying so", "took too long" in str(e), e)
finally:
    P.TIMEOUT, P.BUDGET = saved

# the sizes past which a message is not read in full, with the limits made small enough for the mail here
real = P.FULL_ONE, P.FULL_EACH, P.FULL_ALL
connect = lambda: P.Bridge("http://127.0.0.1:%d" % listing.port, CREDENTIAL)  # noqa: E731
try:
    P.FULL_ONE = 100
    try:
        P.call_message({"id": "INBOX:1111:2", "format": "full"}, connect)
        ok("a message over the size read in full is refused as full", False)
    except P.Refusal as e:
        ok("a message over the size read in full is refused as full, and metadata is named", "format metadata reads its headers" in str(e), e)
    ok("and metadata still reads it", P.call_message({"id": "INBOX:1111:2"}, connect)["size"] == 651)
    P.FULL_ONE, P.FULL_EACH = real[0], 500
    each = {m["messageId"]: m for m in P.call_thread({"id": "INBOX:1111:3", "format": "full"}, connect)["messages"]}
    ok("a message of a thread over the size read in full is shown without its text, marked cut",
       each["<q1@example.com>"].get("truncated") is True and "text" not in each["<q1@example.com>"]
       and each["<r1@example.com>"]["text"].startswith("Thanks Alice") and "truncated" not in each["<r1@example.com>"], each)
    P.FULL_EACH, P.FULL_ALL = real[1], 800
    total = {m["messageId"]: m for m in P.call_thread({"id": "INBOX:1111:3", "format": "full"}, connect)["messages"]}
    ok("a thread stops reading messages in full when the total is reached: the first is read, the rest are cut",
       total["<q1@example.com>"]["text"].startswith("Hi Bob") and all(total[i].get("truncated") is True and "text" not in total[i]
                                                                       for i in ("<r1@example.com>", "<s1@example.com>")), total)
finally:
    P.FULL_ONE, P.FULL_EACH, P.FULL_ALL = real

