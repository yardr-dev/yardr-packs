atexit.register(cleanup)

# SIGTERM and SIGHUP end the process without running exit handlers, so turn them into sys.exit and
# let the one exit path above run. The code keeps the shell's signal-death convention, 128 plus the
# signal. SIGINT needs none of this: it arrives as an exception, which already runs the handlers.
for _sig in (signal.SIGTERM, signal.SIGHUP):
    signal.signal(_sig, lambda signum, frame: sys.exit(128 + signum))

