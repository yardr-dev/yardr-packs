        f.write(core + "\n")
os.mkdir(core + "/h")


def yrun(*args, stdin=None):
    p = subprocess.run([YARDR, "--home", core + "/y", "--actor", "tester"] + list(args), input=stdin, capture_output=True, text=True,
                       env={"HOME": core + "/h", "PATH": os.environ["PATH"]}, timeout=180)
    if PASSWORD in p.stdout + p.stderr or CREDENTIAL in p.stdout + p.stderr:
        leaks.append("yardr " + " ".join(args))
    return p


def holding(root, needle):
    """The regular files under root that hold needle: a socket is no file to read."""
    found = []
    for here_, _, names in os.walk(root):
        for name in names:
            path = os.path.join(here_, name)
            if os.path.isfile(path) and not os.path.islink(path):
                with open(path, "rb") as f:
                    if needle in f.read():
                        found.append(path)
    return found


