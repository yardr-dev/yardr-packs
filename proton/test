def gen(mid, subject, body, refs=(), reply=None, date="Mon, 02 Nov 2026 08:00:00 +0000", extra=(), ctype="text/plain; charset=utf-8",
        to="Bob <bob@example.com>"):
    """A message made here, as bytes."""
    lines = ["From: Gen <gen@example.com>", "To: " + to, "Subject: " + subject, "Date: " + date]
    if mid:
        lines.append("Message-ID: " + mid)
    if reply:
        lines.append("In-Reply-To: " + reply)
    if refs:
        lines.append("References: " + " ".join(refs))
    lines += list(extra) + ["MIME-Version: 1.0", "Content-Type: " + ctype, "", body]
    return "\n".join(lines).encode("utf-8")


