def ok(name, condition, detail=""):
    print("test: %s %s" % (name, "ok" if condition else "FAILED" + (": " + str(detail) if detail else "")))
    if not condition:
        failed.append(name)


def golden(name, value):
    """Holds value, as JSON, to testdata/golden/<name>.json."""
    path = os.path.join(HERE, "testdata", "golden", name + ".json")
    text = json.dumps(value, indent=2, ensure_ascii=False) + "\n"
    if UPDATE:
        os.makedirs(os.path.dirname(path), exist_ok=True)
        if not os.path.exists(path) or open(path, encoding="utf-8").read() != text:
            with open(path, "w", encoding="utf-8") as f:
                f.write(text)
            print("test: %s golden written" % name)
        return
    if not os.path.exists(path):
        ok("golden " + name, False, "no golden %s (UPDATE_GOLDEN=1 ./test writes it)" % path)
        return
    want = open(path, encoding="utf-8").read()
    diff = "\n".join(list(difflib.unified_diff(want.splitlines(), text.splitlines(), "golden", "answer", lineterm=""))[:30])
    ok("golden " + name, want == text, "differs from %s:\n%s" % (path, diff))


