# exit
# =====================================================================================
# A run that dies after its temp dir is made must not leave it. Only a process shows that, so this
# file is run again with an openssl that fails: the certificate is the first step after the dir is
# made, and it exits there. The stand-in writes its arguments down, and they name the dir that run made.
# The copy is told it is one, so that if it ever got as far as this it would not start another.
if "PROTON_TEST_COPY" not in os.environ:
    standin = tmp + "/standin"
    os.mkdir(standin)
    with open(standin + "/openssl", "w") as f:
        f.write("#!/bin/sh\nprintf '%s\\n' \"$@\" > " + shlex.quote(standin + "/args") + "\nexit 1\n")
    os.chmod(standin + "/openssl", 0o755)
    # The copy takes a fraction of a second. The timeout is for one that does not stop at the certificate.
    exited = subprocess.run([sys.executable, os.path.join(HERE, "test")], capture_output=True, text=True, timeout=60,
                            env=dict(os.environ, PATH=standin + os.pathsep + os.environ["PATH"], PROTON_TEST_COPY="1"))
    asked = open(standin + "/args").read() if os.path.exists(standin + "/args") else ""
    keyout = re.search(r"^-keyout\n(/tmp/protont\.[^/\n]+)/key\.pem$", asked, re.M)
    ok("a copy of this file with an openssl that fails exits 1 at the certificate, after it made its temp dir",
       exited.returncode == 1 and "certificate could not be made" in exited.stdout and keyout is not None,
       (exited.returncode, exited.stdout[-200:], exited.stderr[-200:], asked))
    ok("that temp dir is gone when the copy has exited", keyout is not None and not os.path.exists(keyout.group(1)), keyout and keyout.group(1))
    if keyout:
        # what a run that did not clean up would have left: this run does not add to it
        shutil.rmtree(keyout.group(1), ignore_errors=True)

    # A run ended by SIGTERM or SIGHUP must leave nothing either: no temp dir, and no server. Only
    # a process shows that too, so a copy is run for real, and once its server is up — server.pid
    # under its scratch yard names it — the copy itself is ended with the signal.
    for sig, name in ((signal.SIGTERM, "SIGTERM"), (signal.SIGHUP, "SIGHUP")):
        logpath = tmp + "/signal-" + name.lower() + ".out"
        dirsfile = tmp + "/signal-" + name.lower() + ".dirs"
        log = open(logpath, "w")
        copy = subprocess.Popen([sys.executable, os.path.join(HERE, "test")], stdout=log, stderr=subprocess.STDOUT,
                                env=dict(os.environ, PROTON_TEST_COPY="1", PROTON_TEST_SIGNAL_DIRS=dirsfile))
        try:
            # Wait for its own server pid, with a bound in case setup never reaches one.
            pidfile, server = None, None
            signal_tmp, signal_core = None, None
            waiting_since = time.monotonic()
            while server is None and copy.poll() is None and time.monotonic() - waiting_since < 60:
                try:
                    with open(dirsfile) as f:
                        child_dirs = f.read().splitlines()
                except OSError:
                    child_dirs = []
                if child_dirs:
                    signal_tmp = child_dirs[0]
                if len(child_dirs) > 1:
                    signal_core = child_dirs[1]
                    pidfile = signal_core + "/y/server.pid"
                    if os.path.exists(pidfile):
                        try:
                            server = int(open(pidfile).read().strip())
                        except (OSError, ValueError):
                            server = None
                if server is None:
                    time.sleep(0.2)
            if copy.poll() is None:
                copy.send_signal(sig)
            try:
                rc = copy.wait(timeout=120)
            except subprocess.TimeoutExpired:
                copy.kill()
                rc = copy.wait()
        finally:
            if copy.poll() is None:
                copy.kill()
                copy.wait()
            log.close()
        tail = open(logpath).read()[-500:]
        ok("the %s copy's server is up before it is signalled" % name, server is not None, (pidfile, copy.poll(), tail))
        ok("the copy ended by %s exits %d" % (name, 128 + sig), rc == 128 + sig, (rc, tail))
        left = [d for d in (signal_tmp, signal_core) if d and os.path.exists(d)]
        ok("the copy ended by %s leaves no temp dir" % name, left == [], (left, tail))
        running = server
        if running is not None:
            gone_by = time.monotonic() + 10
            while time.monotonic() < gone_by:
                try:
                    os.kill(running, 0)
                except ProcessLookupError:
                    running = None
                    break
                time.sleep(0.2)
        ok("the copy ended by %s leaves its server stopped" % name, server is not None and running is None, (server, running, tail))
        for d in left:
            # If cleanup failed, stop and remove only this copy's scratch yard.
            if d == signal_core:
                subprocess.run([YARDR, "--home", d + "/y", "--actor", "tester", "server", "stop"], capture_output=True,
                               env={"HOME": d + "/h", "PATH": os.environ["PATH"]})
            shutil.rmtree(d, ignore_errors=True)

