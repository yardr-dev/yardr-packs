class Fake:
    """The part of Bridge that search() sends its commands to: it keeps them and answers in turn."""

    def __init__(self, *answers):
        self.calls, self.answers = [], list(answers)

    def search(self, key, literal=None):
        self.calls.append((key, literal))
        return self.answers[len(self.calls) - 1]


