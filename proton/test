def env_for(stub, **over):
    env = {"PATH": os.environ["PATH"], "HOME": tmp, "PROTON_BRIDGE": CREDENTIAL,
           "YARDR_SOURCE_BASE": "http://127.0.0.1:%d" % stub.port}
    for key, value in over.items():
        if value is None:
            env.pop(key, None)
        else:
            env[key] = value
    return env


def run(stub, call, params=None, stdin=None, **over):
    """(exit status, stdout, stderr) of proton-imap as the yard runs it."""
    given = stdin if stdin is not None else json.dumps({"params": params or {}})
    env = env_for(stub, **over)
    p = subprocess.run([PROGRAM, call], input=given, capture_output=True, text=True, env=env, timeout=120)
    # What no output may hold: the password, and whatever login this run was given
    # (a wrong one is no less a login), unless that is too short to tell from words.
    secret = env.get("PROTON_BRIDGE", "")
    needles = {PASSWORD, CREDENTIAL} | ({secret, secret.partition(":")[2]} if len(secret.partition(":")[2]) >= 8 else set())
    for text in (p.stdout, p.stderr):
        if any(n in text for n in needles):
            leaks.append("%s %s" % (call, params))
    return p.returncode, p.stdout, p.stderr


def answer(stub, call, params=None, **over):
    rc, out, err = run(stub, call, params, **over)
    if rc != 0:
        raise AssertionError("%s %s exited %d: %s" % (call, params, rc, err.strip()))
    return json.loads(out)


def refused(stub, call, params, want, name, status=1, **over):
    rc, out, err = run(stub, call, params, **over)
    ok(name, rc == status and out == "" and want in err and err.count("\n") == 1,
       "exit %d, stdout %r, stderr %r, wanted %r in one line" % (rc, out[:80], err, want))


