#!/bin/sh
# A verified email body to the yard's envelope: stdin
# {"headers":{…},"body":{…}}, stdout the envelope. Needs jq.
#
# The body is the Worker's object: {message_id, from: {address, name},
# to: [], subject, date, in_reply_to, references: [], text,
# attachments: []}. Only the Worker can sign one, so a body that is
# not an object is refused: a non-zero exit is answered 400, and the
# delivery reaches no subscription. Nothing of the body is ever printed
# to stderr.
#
# The thread is the mail's conversation: the References root, else
# In-Reply-To, else the Message-ID itself. The sender's address is
# carried lowercased, as actor.id and as fields.sender, which hear
# matches by identity; the declaration folds a stored key the same way.
exec jq -c '
def str($v): if ($v | type) == "string" then $v elif $v == null then "" else "\($v)" end;
# trunc is hooks.truncate: whitespace collapsed, at most 500 runes. The jq
# POSIX space class includes the Unicode spaces split by Go strings.Fields.
def trunc: (gsub("^[[:space:]]+|[[:space:]]+$"; "") | gsub("[[:space:]]+"; " ")) | if length > 500 then .[0:499] + "…" else . end;

(.body | if type == "object" then . else error("email body is not an object") end) as $b
| (str($b.from.address) | ascii_downcase) as $sender
| (str($b.from.name)) as $name
| (($b.references // []) | map(select(type == "string" and . != ""))) as $refs
| (if ($refs | length) > 0 then $refs[0] elif str($b.in_reply_to) != "" then str($b.in_reply_to) else str($b.message_id) end) as $thread
| {source: "cloudflare-email", type: "message", action: "received",
   actor: {id: $sender, name: (if $name != "" then $name else $sender end)},
   thread: {id: $thread, title: str($b.subject)},
   text: (str($b.text) | trunc), mentions: [],
   fields: {sender: [$sender],
            to: (($b.to // []) | map(select(type == "string" and . != ""))),
            subject: [str($b.subject)]}}
'
