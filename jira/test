#!/bin/sh
# The jira pack's tests: what the gate runs beside yardr pack check.
# Needs no network and no secret, done in seconds.
#
#   hook     each webhook body in testdata/hook is turned into the yard's
#            envelope by jira/normalize; its output must match the golden
#            beside it byte for byte. The documented signature of a known
#            payload is checked against what the declaration says of the
#            signature's header, prefix and encoding.
#   mint     jira/mint makes the Basic credential from the email and the
#            token, and says nothing of either when it cannot.
#   thread   each testdata/thread/*.case is one run of jira/thread against a
#            stand-in curl (testdata/bin/curl) that records each request and
#            answers from the case. The case's golden holds the requests (a
#            changed request is a changed golden), the exit status, stdout
#            and stderr. No secret reaches an argument, an output or the
#            log: the stand-in checks the arguments, and the run checks
#            the rest.
#   core     the declaration as the yard reads it, its calls pinned to a
#            golden; the check call made through the real yardr against a
#            loopback stand-in, minted by jira/mint; and what a pack applied
#            again does to a host the operator edited. These run in a
#            scratch yard of their own and want yardr and python3; where one
#            is missing the test says so and goes on.
#
# UPDATE_GOLDEN=1 ./test writes the goldens again: read the diff before
# committing it.
set -u
cd "$(dirname "$0")"
here=$(pwd)
fail=0
tmp=$(mktemp -d)
cleanup() {
  [ -z "${standin_pid:-}" ] || kill "$standin_pid" 2>/dev/null
  if [ -n "${core:-}" ]; then
    # The scratch yard's server starts on its first command and would
    # outlive the directory it owns: stop it first.
    env -i HOME="$core/h" PATH="$PATH" "$YARDR" --home "$core/y" --actor tester server stop >/dev/null 2>&1
    rm -rf "$core"
  fi
  rm -rf "$tmp"
}
trap cleanup EXIT HUP INT TERM

# check <name> <actual file> <golden file>
check() {
  if [ "${UPDATE_GOLDEN:-}" = 1 ]; then
    if ! cmp -s "$2" "$3"; then cp "$2" "$3"; echo "test: $1 golden written"; fi
    return
  fi
  if [ ! -e "$3" ]; then
    echo "test: $1 has no golden $3 (UPDATE_GOLDEN=1 ./test writes it)"
    fail=1
  elif cmp -s "$2" "$3"; then
    echo "test: $1 ok"
  else
    echo "test: $1 differs from $3:"
    diff "$3" "$2" | sed 's/^/    /' | head -30
    fail=1
  fi
}
# ok <name> <condition's exit status> [detail]
ok() {
  if [ "$2" = 0 ]; then echo "test: $1 ok"; else echo "test: $1 FAILED${3:+: $3}"; fail=1; fi
}

# The account the tests use is a fixture, not a secret.
email=ada@example.com
token=tok-FIXTURE-0123456789abcdef
auth=$(printf '{"inputs":{"JIRA_EMAIL":"%s","JIRA_API_TOKEN":"%s"},"scope":""}' "$email" "$token" | ./jira/mint | jq -r .token)

# ---- hook ------------------------------------------------------------------
for f in testdata/hook/*.json; do
  n=$(basename "$f" .json)
  env -i PATH="$PATH" YARDR_SOURCE_BASE=https://acme.atlassian.net ./jira/normalize <"$f" >"$tmp/$n.out" 2>"$tmp/$n.err"
  check "normalize $n" "$tmp/$n.out" "testdata/hook/$n.golden"
  [ ! -s "$tmp/$n.err" ]
  ok "normalize $n prints nothing to stderr" $? "$(head -c 200 "$tmp/$n.err")"
done

# Every key an envelope's fields carry is one the declaration lists in
# hook.keys (or one the core knows already), and every key it lists is
# set by some envelope here.
keys=$(sed -n 's/^  keys: \[\(.*\)\]$/\1/p' jira.yaml | tr -d ' ' | tr ',' ' ')
seen=$(for g in testdata/hook/*.golden; do jq -r '.fields // {} | keys[]' "$g"; done | sort -u | tr '\n' ' ')
bad=
for k in $seen; do
  case " $keys team project repo label " in *" $k "*) ;; *) bad="$bad $k is set and in no hook.keys;" ;; esac
done
for k in $keys; do
  case " $seen " in *" $k "*) ;; *) bad="$bad hook.keys lists $k and no envelope sets it;" ;; esac
done
[ -z "$bad" ]
ok "fields and hook.keys agree" $? "$bad"

# refuse <name> <body> <stderr wanted>: a body normalize will not read is
# refused with a fixed line that quotes none of it.
refuse() {
  printf '%s' "$2" | env -i PATH="$PATH" ./jira/normalize >"$tmp/r.out" 2>"$tmp/r.err"
  rc=$?
  line=$(sed 's/^jq: error (at [^)]*): //' "$tmp/r.err")
  [ "$rc" != 0 ] && [ ! -s "$tmp/r.out" ] && [ "$line" = "$3" ]
  ok "normalize refuses $1" $? "exit $rc, stdout $(wc -c <"$tmp/r.out") bytes, stderr: $line"
}
refuse "a body that is not an object" '{"headers":{},"body":"text"}' "jira body is not an object"
refuse "a delivery with no event" '{"headers":{},"body":{"issue":{"key":"X-1"}}}' "jira delivery names no webhookEvent"
refuse "a shape it cannot read, without quoting it" '{"headers":{},"body":{"webhookEvent":"jira:issue_created","issue":{"key":"X-1","fields":"QUOTED-BODY-TEXT"}}}' "jira body is not in a shape normalize reads"

# ---- mint ------------------------------------------------------------------
printf '{"inputs":{"JIRA_EMAIL":"%s","JIRA_API_TOKEN":"%s"},"scope":"SHED-7"}' "$email" "$token" | ./jira/mint >"$tmp/mint.out"
want=$(printf '%s:%s' "$email" "$token" | base64 | tr -d '\n')
[ "$(jq -r .token "$tmp/mint.out")" = "$want" ]
ok "mint makes base64 of email:token" $?
jq -e '(.expires_at | test("^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$")) and (.expires_at | fromdateiso8601) > now and ((keys | sort) == ["expires_at", "token"])' "$tmp/mint.out" >/dev/null
ok "mint answers a future RFC 3339 expiry and nothing else" $?
i=0
for bad in '{"inputs":{"JIRA_EMAIL":"'"$email"'"}}' '{"inputs":{"JIRA_API_TOKEN":"'"$token"'"}}' '{"inputs":{"JIRA_EMAIL":"","JIRA_API_TOKEN":"'"$token"'"}}' '{"inputs":"'"$token"'"}' 'not json '"$token"; do
  i=$((i + 1))
  printf '%s' "$bad" | ./jira/mint >"$tmp/m.out" 2>"$tmp/m.err"
  rc=$?
  [ "$rc" = 1 ] && [ ! -s "$tmp/m.out" ] && [ "$(cat "$tmp/m.err")" = "jira/mint: want JIRA_EMAIL and JIRA_API_TOKEN among the inputs" ]
  ok "mint refuses input $i with a fixed line that quotes none of it" $?
done

# ---- thread ----------------------------------------------------------------
ago=$(jq -nr 'now - 300 | todate')
# A case file is sections, each opened by a line "=== name": cmd (the
# command), base (YARDR_SOURCE_BASE, the shipped placeholder's host
# otherwise), in (the object on stdin) and answer_n (the nth request's
# answer: its status, then its body).
for c in testdata/thread/*.case; do
  n=$(basename "$c" .case)
  d="$tmp/case_$n"
  mkdir "$d"
  # @AUTH@ is the credential the run is given and @AGO@ a time five minutes
  # back, where a fixture needs the run's own (an answer that echoes the
  # credential, an open whose attempt was put on record a moment ago).
  sed -e "s|@AUTH@|$auth|g" -e "s|@AGO@|$ago|g" "$c" | awk -v dir="$d" '/^=== /{ name = substr($0, 5); f = dir "/" name; printf "" > f; next } { print >> f }'
  base=https://acme.atlassian.net
  [ ! -e "$d/base" ] || base=$(cat "$d/base")
  : >"$tmp/requests"
  rm -f "$tmp/requests.n"
  env -i PATH="$here/testdata/bin:$PATH" HOME="$tmp" JIRA_AUTH="$auth" YARDR_SOURCE_BASE="$base" \
    FAKE_CASE="$d" FAKE_LOG="$tmp/requests" FAKE_AUTH="Basic $auth" FAKE_SECRETS="$token $auth" \
    ./jira/thread "$(cat "$d/cmd")" <"$d/in" >"$tmp/stdout" 2>"$tmp/stderr"
  status=$?
  {
    echo "--- requests"
    cat "$tmp/requests"
    echo "--- status"
    echo "$status"
    echo "--- stdout"
    cat "$tmp/stdout"
    [ ! -s "$tmp/stdout" ] || [ "$(tail -c 1 "$tmp/stdout" | wc -l)" -ne 0 ] || echo
    echo "--- stderr"
    cat "$tmp/stderr"
  } >"$tmp/golden"
  if grep -q '@AGO@' "$c"; then
    # The minutes a search looks back are the clock's: the golden has a mark
    # for them, and the range is asserted here.
    sed 's/created >= -[0-9][0-9]*m/created >= -<N>m/' "$tmp/golden" >"$tmp/golden.masked"
    mins=$(sed -n 's/.*created >= -\([0-9][0-9]*\)m.*/\1/p' "$tmp/requests" | head -1)
    [ -n "$mins" ] && [ "$mins" -ge 7 ] && [ "$mins" -le 12 ]
    ok "thread $n looks back the minutes since the attempt was put on record" $? "${mins:-no created clause} minutes for 5 (7 to 12 allowed)"
  else
    cp "$tmp/golden" "$tmp/golden.masked"
  fi
  check "thread $n" "$tmp/golden.masked" "testdata/thread/$n.golden"
  # No secret anywhere a program can put one.
  ! grep -qF -e "$token" -e "$auth" "$tmp/golden"
  ok "thread $n leaks no secret" $?
  ! grep -q "LEAK" "$tmp/requests"
  ok "thread $n passes no secret in an argument" $?
done

# Without its credential the program says what is missing and sends nothing.
: >"$tmp/requests"
rm -f "$tmp/requests.n"
printf '{"thread":"SHED-7"}' | env -i PATH="$here/testdata/bin:$PATH" HOME="$tmp" YARDR_SOURCE_BASE=https://acme.atlassian.net \
  FAKE_CASE="$tmp" FAKE_LOG="$tmp/requests" ./jira/thread read >"$tmp/stdout" 2>"$tmp/stderr"
rc=$?
[ "$rc" != 0 ] && [ ! -s "$tmp/requests" ] && grep -q 'JIRA_AUTH is not set' "$tmp/stderr"
ok "thread without JIRA_AUTH says so and sends nothing" $? "exit $rc"

# ---- core ------------------------------------------------------------------
YARDR=${YARDR:-$(command -v yardr || echo /Users/mckean/go/bin/yardr)}
if [ ! -x "$YARDR" ]; then
  echo "test: core skipped: no yardr ($YARDR)"
elif ! command -v python3 >/dev/null 2>&1; then
  echo "test: core skipped: python3 is not on PATH"
else
  . ./testdata/core.sh
fi

if [ "$fail" = 0 ]; then echo "test: jira: all ok"; else echo "test: jira: FAILED"; fi
exit $fail
