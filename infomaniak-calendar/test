#!/bin/sh
# The infomaniak-calendar pack's tests: what the gate runs beside yardr pack
# check. Needs no network and no secret, done in seconds. Needs jq, curl,
# python3 and yardr, and fails without any of them: a part that was skipped
# would leave the pack unpinned. What it holds is the pack read against
# fixtures shaped after Infomaniak's own MCP server for its calendar, not
# against the service: README.md, "What was checked", says what that leaves
# untried.
#
#   build  infomaniak-calendar/build-edit, the program that builds edit's
#          PUT body, run by itself against a stand-in for the service on a
#          loopback port (testdata/standin.py), one testdata/build/*.case
#          each: the event it reads, the body it prints (only what was
#          given changed, everything else as the event had it, nobody
#          notified), and what it refuses in words with nothing sent. It
#          reads and never writes: no request but a GET reaches the
#          stand-in. The token reaches curl on its stdin and in no
#          argument, and is in no output.
#   core   testdata/core.sh: the real yardr in a scratch yard. The
#          declaration as the yard reads it, the presets and the grants
#          SETUP.md teaches, the check, and each testdata/calls/*.case, one
#          `yardr call` against the same stand-in. A case's golden holds
#          the requests the stand-in saw (method, path and query exactly as
#          they arrived, the body of a write), the exit status, what the
#          call kept of the answer and what it said on stderr; a call the
#          declaration should turn away shows as no request at all. The
#          token is made here for the run and thrown away: the stand-in
#          says only whether a request carried it.
#
# A case file is sections, each opened by a line "=== name": args (the call
# and its parameters, one word to a line), params (what build-edit is given
# on stdin), and routes (what the stand-in answers: METHOD path status
# answer, one to a line, the answer @name for testdata/answers/name.json; a
# request no line names is a 404). UPDATE_GOLDEN=1 ./test writes the goldens
# again from what the programs print; read the diff before keeping it.
set -u
cd "$(dirname "$0")" || exit 1
here=$(pwd)
fail=0

for tool in jq curl python3; do
  command -v "$tool" >/dev/null 2>&1 || { echo "test: $tool is not on PATH: the pack needs it"; exit 1; }
done
YARDR=${YARDR:-$(command -v yardr || echo /Users/mckean/go/bin/yardr)}
[ -x "$YARDR" ] || { echo "test: no yardr ($YARDR): the declaration and the calls are read through it"; exit 1; }

tmp=$(mktemp -d)
# The core part's scratch yard is made when its turn comes, and the yard's
# server, which its first command starts, would outlive the directory it
# owns: stop it first. core is empty until then.
core=
standin_pid=
# The trap runs this, which shellcheck does not see.
# shellcheck disable=SC2329
cleanup() {
  [ -z "${standin_pid:-}" ] || kill "$standin_pid" 2>/dev/null
  if [ -n "${core:-}" ]; then
    env -i HOME="$core/h" PATH="$PATH" "$YARDR" --home "$core/y" --actor tester server stop >/dev/null 2>&1
    rm -rf "${core:?}"
  fi
  rm -rf "${tmp:?}"
}
trap cleanup EXIT
trap 'exit 1' HUP INT TERM

# check <name> <actual file> <golden file>: ok when they are the same.
check() {
  if [ "${UPDATE_GOLDEN:-}" = 1 ]; then
    if ! cmp -s "$2" "$3"; then cp "$2" "$3"; echo "test: $1 golden written"; fi
    return
  fi
  if [ ! -e "$3" ]; then
    echo "test: $1 has no golden $3 (UPDATE_GOLDEN=1 ./test writes it)"
    fail=1
  elif cmp -s "$2" "$3"; then
    echo "test: $1 ok"
  else
    echo "test: $1 differs from $3:"
    diff "$3" "$2" | sed 's/^/    /' | head -30
    fail=1
  fi
}
# ok <name> <condition's exit status> [detail]
ok() {
  if [ "$2" = 0 ]; then echo "test: $1 ok"; else echo "test: $1 FAILED${3:+: $3}"; fail=1; fi
}

# ---- the token, made here and thrown away --------------------------------------
# A random value for each run: the stand-in knows it, the yard is given it as
# SETUP.md gives a token, and none of the pack's files can hold it.
token=$(od -An -N24 -tx1 /dev/urandom | tr -d ' \n')
[ "${#token}" = 48 ] || { echo "test: no random token could be made"; exit 1; }
(umask 077 && printf '%s\n' "$token" >"$tmp/token")

# ---- the stand-in ----------------------------------------------------------------
: >"$tmp/requests"
: >"$tmp/routes"
python3 -I testdata/standin.py "$tmp/port" "$tmp/requests" "$tmp/routes" "$tmp/token" 2>"$tmp/standin.err" &
standin_pid=$!
i=0
while [ ! -s "$tmp/port" ] && [ "$i" -lt 200 ]; do sleep 0.05; i=$((i + 1)); done
if [ ! -s "$tmp/port" ]; then
  echo "test: the stand-in did not listen: $(cat "$tmp/standin.err")"
  exit 1
fi
site=http://127.0.0.1:$(cat "$tmp/port")

# split_case <case file> <dir>: each section of the case becomes a file of
# its own in the dir, named for it.
split_case() {
  awk -v dir="$2" '/^=== /{ name = substr($0, 5); f = dir "/" name; printf "" > f; next } name != "" { print >> f }' "$1"
}
# set_routes <routes file>: what the stand-in answers from now on. An answer
# @name is testdata/answers/name.json; a line that starts with # is a
# comment, and no file at all is no route.
set_routes() {
  : >"$tmp/routes"
  [ -e "$1" ] || return 0
  while read -r method path status answer; do
    case $method in '' | '#'*) continue ;; esac
    case $answer in @*) answer=$here/testdata/answers/${answer#@}.json ;; esac
    printf '%s %s %s %s\n' "$method" "$path" "$status" "$answer" >>"$tmp/routes"
  done <"$1"
}
# golden_of <dir> <status>: the four parts of a case's golden, from the
# stand-in's log and the files the run left in the dir.
golden_of() {
  echo "--- requests"
  cat "$tmp/requests"
  echo "--- status"
  echo "$2"
  echo "--- stdout"
  if [ -s "$1/stdout" ]; then jq -S . "$1/stdout" 2>/dev/null || cat "$1/stdout"; fi
  echo "--- stderr"
  cat "$1/stderr"
}

# ---- build -----------------------------------------------------------------------
mkdir "$tmp/work" "$tmp/home"
# build_run <dir> <stdin file> [extra env...]: build-edit as the core runs a
# build, in a bare environment and from a directory of its own: stdout and
# stderr land in the dir, and the status is in $rc.
build_run() {
  _d=$1 _in=$2
  shift 2
  (cd "$tmp/work" && env -i PATH="$PATH" HOME="$tmp/home" INFOMANIAK_CALENDAR_TOKEN="$token" YARDR_SOURCE_BASE="$site" "$@" "$here/infomaniak-calendar/build-edit" <"$_in" >"$_d/stdout" 2>"$_d/stderr")
  rc=$?
}
for c in testdata/build/*.case; do
  n=$(basename "$c" .case)
  d=$tmp/build_$n
  mkdir "$d"
  split_case "$c" "$d"
  set_routes "$d/routes"
  : >"$tmp/requests"
  build_run "$d" "$d/params"
  golden_of "$d" "$rc" >"$d/golden"
  check "build $n" "$d/golden" "testdata/build/$n.golden"
done

# What every run of the program did: it read and it never wrote, with the
# token, and the token is in none of what it printed.
cat "$tmp"/build_*/golden >"$tmp/build.all"
! grep -E '^[A-Z]+ ' "$tmp/build.all" | grep -vE '^GET /1/calendar/pim/event/[1-9][0-9]*$' | grep -q .
ok "build-edit's only requests are a GET of one event" $?
! grep -qE 'auth: (missing|WRONG)' "$tmp/build.all"
ok "every request of build-edit carried the token as a bearer" $?
! grep -qF "$token" "$tmp"/build_*/stdout "$tmp"/build_*/stderr
ok "the token is in no output of build-edit" $?

# The same program with what it needs left out, each refused in one line.
# refuses <what> <wanted on stderr> <stdin> [env, with PATH set by the caller]
refuses() {
  _what=$1 _want=$2
  d=$tmp/refuse
  rm -rf "$d"
  mkdir "$d"
  printf '%s' "$3" >"$d/in"
  shift 3
  : >"$tmp/requests"
  set_routes /dev/null
  build_run "$d" "$d/in" "$@"
  bad=
  [ "$rc" = 1 ] || bad="$bad exit $rc, wanted 1;"
  [ ! -s "$d/stdout" ] || bad="$bad stdout is not empty;"
  [ "$(cat "$d/stderr")" = "$_want" ] || bad="$bad stderr is '$(cat "$d/stderr")';"
  [ ! -s "$tmp/requests" ] || bad="$bad a request was made;"
  grep -qF "$token" "$d/stderr" "$d/stdout" && bad="$bad the token is in the output;"
  [ -z "$bad" ]
  ok "build-edit refuses $_what, with nothing sent" $? "$bad"
}
good='{"params": {"eventId": "42", "summary": "x"}}'
refuses "no token" 'infomaniak-calendar/build-edit: INFOMANIAK_CALENDAR_TOKEN is not set' "$good" INFOMANIAK_CALENDAR_TOKEN=
refuses "a token with a line break" 'infomaniak-calendar/build-edit: INFOMANIAK_CALENDAR_TOKEN holds a line break' "$good" "INFOMANIAK_CALENDAR_TOKEN=$(printf 'a\nb')"
refuses "no base" 'infomaniak-calendar/build-edit: YARDR_SOURCE_BASE is not set' "$good" YARDR_SOURCE_BASE=
for tool in jq curl; do
  mkdir "$tmp/without-$tool"
  for p in cat tr jq curl; do
    [ "$p" = "$tool" ] || ln -s "$(command -v "$p")" "$tmp/without-$tool/$p"
  done
  refuses "a PATH without $tool" "infomaniak-calendar/build-edit: needs $tool on PATH" "$good" "PATH=$tmp/without-$tool"
done

# The token goes to curl on its stdin, as a config line, and in no argument:
# an argument can be read by every process on the machine while curl runs.
# A curl of this run's own records what it was given, and runs the real one.
mkdir "$tmp/spy"
real_curl=$(command -v curl)
cat >"$tmp/spy/curl" <<EOF
#!/bin/sh
printf '%s\n' "\$@" >"$tmp/curl.argv"
tee "$tmp/curl.stdin" | "$real_curl" "\$@"
EOF
chmod +x "$tmp/spy/curl"
d=$tmp/spied
mkdir "$d"
set_routes /dev/null
printf '%s\n' "GET /1/calendar/pim/event/42 200 $here/testdata/answers/event-standup.json" >"$tmp/routes"
: >"$tmp/requests"
printf '%s' '{"params": {"eventId": "42", "summary": "x"}}' >"$d/in"
build_run "$d" "$d/in" "PATH=$tmp/spy:$PATH"
[ "$rc" = 0 ] && [ -s "$tmp/curl.argv" ] && [ -s "$tmp/curl.stdin" ] && ! grep -qF "$token" "$tmp/curl.argv" && grep -qF "Bearer $token" "$tmp/curl.stdin"
ok "build-edit hands curl the token on its stdin and in no argument" $? "exit $rc"

# ---- core ------------------------------------------------------------------------
# shellcheck source=testdata/core.sh
. ./testdata/core.sh

if [ "$fail" = 0 ]; then echo "test: infomaniak-calendar: all ok"; else echo "test: infomaniak-calendar: FAILED"; fi
exit $fail
