{
  "about": "Postiz channels, scheduled posts and drafts. Lists channels, reads scheduled posts, finds a channel's next free slot, uploads one picture, and writes drafts and scheduled posts; publishes nothing at once.",
  "base": "https://api.postiz.com/public/v1",
  "calls": [
    {
      "about": "List the workspace's channels, each with its id, name, network, picture, whether it is disabled, and its profile",
      "answer": {
        "max": 65536,
        "select": [
          "id",
          "name",
          "identifier",
          "picture",
          "disabled",
          "profile",
          "customer"
        ]
      },
      "kind": "read",
      "name": "channels",
      "request": {
        "method": "GET",
        "path": "/integrations"
      }
    },
    {
      "about": "Read the posts in a window, scheduled, drafted, published and failed",
      "answer": {
        "max": 262144,
        "select": [
          "posts"
        ]
      },
      "kind": "read",
      "name": "posts",
      "params": [
        {
          "max": 30,
          "name": "start",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,3})?Z?$",
          "type": "string"
        },
        {
          "max": 30,
          "name": "end",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,3})?Z?$",
          "type": "string"
        }
      ],
      "request": {
        "method": "GET",
        "path": "/posts",
        "query": [
          {
            "key": "startDate",
            "value": "{start}"
          },
          {
            "key": "endDate",
            "value": "{end}"
          }
        ]
      }
    },
    {
      "about": "Ask a channel for its next free posting slot, from its time slots",
      "answer": {
        "max": 65536,
        "select": [
          "date"
        ]
      },
      "kind": "read",
      "name": "slot",
      "params": [
        {
          "log": true,
          "max": 64,
          "name": "channel",
          "pattern": "^[A-Za-z0-9_-]{1,64}$",
          "type": "string"
        }
      ],
      "request": {
        "method": "GET",
        "path": "/find-slot/{channel}"
      }
    },
    {
      "about": "Write a draft for one or more channels, saved and never published",
      "answer": {
        "max": 65536,
        "select": [
          "postId",
          "integration"
        ]
      },
      "build": [
        "build-post",
        "draft"
      ],
      "kind": "update",
      "name": "draft",
      "params": [
        {
          "log": true,
          "max": 2000,
          "name": "channels",
          "pattern": "^[a-z0-9-]+:[A-Za-z0-9_-]+(,[a-z0-9-]+:[A-Za-z0-9_-]+)*$",
          "type": "string"
        },
        {
          "max": 10000,
          "name": "text",
          "type": "string"
        },
        {
          "max": 200,
          "name": "image_id",
          "optional": true,
          "pattern": "^[A-Za-z0-9_-]{1,200}$",
          "type": "string"
        },
        {
          "max": 2000,
          "name": "image_path",
          "optional": true,
          "pattern": "^https://[^[:space:]]+$",
          "type": "string"
        },
        {
          "default": "everyone",
          "name": "replies",
          "optional": true,
          "type": "enum",
          "values": [
            "everyone",
            "following",
            "mentionedUsers",
            "subscribers",
            "verified"
          ]
        }
      ],
      "request": {
        "method": "POST",
        "path": "/posts"
      }
    },
    {
      "about": "Schedule a post for one or more channels at a given time",
      "answer": {
        "max": 65536,
        "select": [
          "postId",
          "integration"
        ]
      },
      "build": [
        "build-post",
        "schedule"
      ],
      "kind": "update",
      "name": "schedule",
      "params": [
        {
          "log": true,
          "max": 2000,
          "name": "channels",
          "pattern": "^[a-z0-9-]+:[A-Za-z0-9_-]+(,[a-z0-9-]+:[A-Za-z0-9_-]+)*$",
          "type": "string"
        },
        {
          "max": 10000,
          "name": "text",
          "type": "string"
        },
        {
          "name": "date",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,3})?Z?$",
          "type": "string"
        },
        {
          "max": 200,
          "name": "image_id",
          "optional": true,
          "pattern": "^[A-Za-z0-9_-]{1,200}$",
          "type": "string"
        },
        {
          "max": 2000,
          "name": "image_path",
          "optional": true,
          "pattern": "^https://[^[:space:]]+$",
          "type": "string"
        },
        {
          "default": "everyone",
          "name": "replies",
          "optional": true,
          "type": "enum",
          "values": [
            "everyone",
            "following",
            "mentionedUsers",
            "subscribers",
            "verified"
          ]
        }
      ],
      "request": {
        "method": "POST",
        "path": "/posts"
      }
    },
    {
      "about": "Upload one picture for a post to carry, and read back its id and path",
      "answer": {
        "max": 65536,
        "select": [
          "id",
          "name",
          "path",
          "organizationId",
          "createdAt",
          "updatedAt",
          "status"
        ]
      },
      "kind": "update",
      "name": "upload",
      "params": [
        {
          "max": 10485760,
          "name": "file",
          "type": "file"
        }
      ],
      "request": {
        "body": {
          "file": "{file}"
        },
        "method": "POST",
        "path": "/upload"
      }
    }
  ],
  "check": "channels",
  "credential": {
    "env": "POSTIZ_API_KEY",
    "header": "Authorization: {credential}"
  },
  "name": "postiz"
}
